
set SOLVER MODE=INVERSE
subsection POST PROCESS
  set WRITE VTU FILE = true
  set INTERPOLATE TO POINTS = true
  set READ POINTS FROM FILE = false
  set FILENAME FOR OUTPUT = vxcFinalpp_vxc0p06_ball6p0_ldaFrac1p0_6_135
  set STARTING X=0.0
  set STARTING Y=15.0
  set STARTING Z=-15.0
  set ENDING X=0.0
  set ENDING Y=0.0
  set ENDING Z=15.0
  set NUMBER OF POINTS ALONG X DIRECTION = 1
  set NUMBER OF POINTS ALONG Y DIRECTION = 1
  set NUMBER OF POINTS ALONG Z DIRECTION = 6000
end

subsection Inverse DFT parameters
   set TOL FOR BFGS = 1e-12
   set BFGS LINE SEARCH = 2
   set TOL FOR BFGS LINE SEARCH = 1e-6
   set BFGS HISTORY = 10
   set BFGS MAX ITERATIONS = 10000
   set READ FE DENSITY DATA = false
   set FE DENSITY FILENAME = density_LiF_2_hf_dftfe_correctNorm_tigtherTol_gs.txt 
   set READ FE DENSITY DATA WITH SPIN = false
   set TOL FOR DIST BETWEEN POINTS = 1E-3
   set READ VXC DATA = false
   set POSTFIX TO THE FILENAME FOR READING VXC DATA = vxcData_mesh0p06_ball6p0_temp10_1_20 
   set WRITE VXC DATA = true
   set FOLDER FOR VXC DATA = vxcDataOut
   set POSTFIX TO THE FILENAME FOR WRITING VXC DATA = vxcData_mesh0p06_ball6p0_temp10_2
   set FREQUENCY FOR WRITING VXC = 5
   set RHO TOL FOR CONSTRAINTS = 1e-6
   set VXC MESH DOMAIN SIZE = 8.0
   set FACTOR FOR CORR POTENTIAL = 1.0
   set VXC MESH SIZE NEAR ATOM = 0.06
   set BLOCK SIZE OF INTERPOLATE = 14
   set INITIAL TOL FOR CHEBYSHEV FILTERING = 1e-7
   set ALPHA1 FOR WEIGHTS FOR LOSS FUNCTION = 0.0
   set ALPHA2 FOR WEIGHTS FOR LOSS FUNCTION = 0.0
   set TAU FOR WEIGHTS FOR LOSS FUNCTION = 1e-5
   set TAU FOR WEIGHTS FOR SETTING VX BC = 1e-8
   set TAU FOR WEIGHTS FOR SETTING FABC = 1e-2
   set TOL FOR FRACTIONAL OCCUPANCY = 1e-8
   set TOL FOR DEGENERACY = 0.005
   set READ GAUSSIAN DATA AS INPUT = true
   set READ SLATER DATA AS INPUT = false
   set SET FERMIAMALDI IN THE FAR FIELD AS INPUT = true
   set USE DELTA RHO CORRECTION                      = true
   set GAUSSIAN DENSITY FOR PRIMARY RHO SPIN UP = DensityMatrx_CI_ccpv5z_spin0
   set GAUSSIAN DENSITY FOR DFT RHO SPIN UP = DensityMatrx_hf_ccpv5z_spin0
   set ATOMIC ORBITAL ATOMIC COORD FILE = AtomicCoords
   set GAUSSIAN S MATRIX FILE = SMatrix_ccpv5z_vaibhav
end
