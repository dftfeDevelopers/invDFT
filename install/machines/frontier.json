{
  "_notes": [
    "OLCF Frontier: HPE Cray EX, AMD EPYC (znver3) + AMD MI250X (gfx90a).",
    "Based on the frontierDevelop branch of dftfeDevelopers/install_DFTFE.",
    "GPU builds link the Cray GTL library ($PE_MPICH_GTL_*) for GPU-aware MPICH.",
    "ELPA is compiled with hipcc and the MPICH/GTL libraries are passed explicitly."
  ],
  "description": "OLCF Frontier (HPE Cray EX, AMD EPYC + AMD MI250X)",
  "detect": {
    "lmod_system_name": ["frontier"],
    "hostname_regex": ["frontier"]
  },
  "cray": true,
  "compilers": {"cc": "cc", "cxx": "CC", "fc": "ftn", "mpicc": "cc", "mpicxx": "CC", "mpifc": "ftn"},
  "march": "-march=znver3",
  "modules": ["cpe/25.09", "PrgEnv-gnu", "gcc-native", "cmake", "boost"],
  "gpu_modules": {"amd": ["craype-accel-amd-{arch}", "rocm"]},
  "blas_modules": {"libsci": ["cray-libsci"]},
  "gpu_exports": {"MPICH_GPU_SUPPORT_ENABLED": "1"},
  "defaults": {"gpu": true, "gpu_vendor": "amd", "gpu_arch": "gfx90a", "blas": "blis+flame"},
  "versions": {"libxc": "7.0.0", "kokkos": "4.6.00", "elpa": "2026.02.001"},
  "dccl_prefix": {"amd": "$ROCM_PATH"},
  "elpa_cpu_configure": "--disable-avx512",
  "gpu": {
    "amd": {
      "cxx_flags": "{march} -fPIC -I$MPICH_DIR/include -I$ROCM_PATH/include -I$ROCM_PATH/include/hip -I$ROCM_PATH/include/hipblas -I$ROCM_PATH/include/rocblas",
      "device_flags": "{march} -O2 -munsafe-fp-atomics -I$MPICH_DIR/include -I$ROCM_PATH/include -I$ROCM_PATH/include/hip -I$ROCM_PATH/include/hipblas -I$ROCM_PATH/include/rocblas",
      "shared_linker_flags": "-L$ROCM_PATH/lib -lamdhip64 -L$MPICH_DIR/lib -lmpi $CRAY_XPMEM_POST_LINK_OPTS -lxpmem $PE_MPICH_GTL_DIR_amd_{arch} $PE_MPICH_GTL_LIBS_amd_{arch}",
      "elpa": {
        "cc": "hipcc",
        "cxx": "hipcc",
        "fc": "ftn",
        "cflags": "{march} -fPIC -O2 $CRAY_ROCM_INCLUDE_OPTS -I$ROCM_PATH/include/rocsolver --offload-arch={arch} -I$MPICH_DIR/include",
        "cxxflags": "-std=c++17 {march} -fPIC -O2 $CRAY_ROCM_INCLUDE_OPTS -I$ROCM_PATH/include/rocsolver --offload-arch={arch} -I$MPICH_DIR/include",
        "fcflags": "{march} -O2 -fPIC",
        "libs": "-L$ROCM_PATH/lib -lamdhip64 -lrocblas -lrocsolver -L$MPICH_DIR/lib -lmpi $CRAY_XPMEM_POST_LINK_OPTS -lxpmem $PE_MPICH_GTL_DIR_amd_{arch} $PE_MPICH_GTL_LIBS_amd_{arch}"
      }
    }
  }
}
