{
  "_notes": [
    "NERSC Perlmutter: HPE Cray EX, AMD EPYC (znver3) + NVIDIA A100 (sm_80).",
    "Based on the perlmutterDevelop branch of dftfeDevelopers/install_DFTFE.",
    "-target-accel=nvidia{arch} is a Cray compiler-wrapper flag.",
    "ELPA's SIMD kernels are disabled, as in the original scripts.",
    "CPU-only builds load the 'cpu' module instead of the GPU modules."
  ],
  "description": "NERSC Perlmutter (HPE Cray EX, AMD EPYC + NVIDIA A100)",
  "detect": {
    "lmod_system_name": ["perlmutter"],
    "env": {"NERSC_HOST": "perlmutter"},
    "hostname_regex": ["perlmutter"]
  },
  "cray": true,
  "compilers": {"cc": "cc", "cxx": "CC", "fc": "ftn", "mpicc": "cc", "mpicxx": "CC", "mpifc": "ftn"},
  "march": "-march=znver3",
  "modules": ["PrgEnv-gnu", "gcc-native", "cray-mpich", "cmake"],
  "cpu_modules": ["cpu"],
  "gpu_modules": {"nvidia": ["cudatoolkit"]},
  "dccl_modules": {"nvidia": ["nccl"]},
  "blas_modules": {"libsci": ["cray-libsci"]},
  "gpu_exports": {"MPICH_GPU_SUPPORT_ENABLED": "1"},
  "defaults": {"gpu": true, "gpu_vendor": "nvidia", "gpu_arch": "80", "blas": "blis+flame"},
  "dccl_prefix": {"nvidia": "$NCCL_DIR"},
  "elpa_cpu_configure": "--disable-sse --disable-sse-assembly --disable-avx --disable-avx2 --disable-avx512",
  "gpu": {
    "nvidia": {
      "cxx_flags": "{march} -fPIC",
      "cxx_flags_release": "-O2 -fPIC -target-accel=nvidia{arch} -I$MPICH_DIR/include",
      "device_flags": "-I$MPICH_DIR/include -arch=sm_{arch}",
      "elpa": {
        "cc": "cc",
        "cxx": "CC",
        "fc": "ftn",
        "cflags": "{march} -fPIC -O2 -target-accel=nvidia{arch} -I$MPICH_DIR/include",
        "cxxflags": "-std=c++17 {march} -fPIC -O2 -target-accel=nvidia{arch} -I$MPICH_DIR/include",
        "fcflags": "-ffree-line-length-none {march} -fPIC -O2 -target-accel=nvidia{arch} -I$MPICH_DIR/include"
      }
    }
  }
}
